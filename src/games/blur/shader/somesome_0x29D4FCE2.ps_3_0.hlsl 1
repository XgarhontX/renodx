sampler2D AlbedoSampler : register( s0 );

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;
	
	float4 r0;
	float4 r1;
	r0.xyz = normalize(i.texcoord1.xyz);
	o.color.xyz = r0.xyz * 0.5 + 0.5;
	r0 = tex2D(AlbedoSampler, i.texcoord);
	r0.x = saturate(i.texcoord1.w);
	r1 = r0.w * r0.x + -0.5;
	r0.x = r0.x * r0.w;
	o.color.w = r0.x;
	clip(r1);
	r0.x = 1 / i.texcoord.w;
	o.color1 = r0.x * i.texcoord.z;

	return o;
}

